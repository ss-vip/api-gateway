{
  // 複製為 config.json 或 config.jsonc 後填入 key 即可啟動。
  // 支援 // 與 /* */ 註解。部分欄位可由環境變數覆寫（見 README）。

  // ── 驗證 ──────────────────────────────────────────────
  // 留空 = 所有端點不驗證，僅適合本機測試。
  "client_token": "sk-your-secret-token",

  // ── 執行期 ────────────────────────────────────────────
  "timezone": "Asia/Taipei",
  "port": 3000,
  "timeout": 600000,
  // 單次 upstream 無回應的容忍時間（非整體預算）。
  "upstream_timeout": 120000,
  // 超過視為截斷（回 502）。
  "upstream_max_body": 20971520,
  // 超過回 413。
  "max_body_size": 10485760,

  // ── 金鑰健康度 ────────────────────────────────────────
  // 首次冷卻（毫秒），之後指數退避。
  "key_cooldown": 30000,
  "max_key_backoff": 300000,
  // quota / billing 耗盡時的長時間降級（毫秒）。
  "quota_backoff": 3600000,

  // ── 熔斷與併發 ────────────────────────────────────────
  "model_lockout": {
    "threshold": 3,
    "cooldown_ms": 60000
  },
  "circuit_breaker": {
    "threshold": 5,
    "cooldown_ms": 30000
  },
  "provider_concurrency": {
    "max_concurrent": 4
  },

  // ── 日誌 ──────────────────────────────────────────────
  "log": {
    "enabled": true,
    "retention_days": 7,
    // 超過輪替為 <path>.1（只留前一代）。
    "max_size_mb": 100,
    // 相對路徑以設定檔所在目錄為基準。
    "path": "./log.json",
    // true 會把上游錯誤內文（含 prompt / PII）寫入日誌並推送到 /console。
    "capture_error_body": false
  },

  // ── 圖片預處理 ────────────────────────────────────────
  // 留空則由 providers 自動推導；只允許 https，單檔 8MB。
  "allowed_image_origins": [
    "https://openai.com",
    "https://cdn.openai.com"
  ],

  // ── Provider ──────────────────────────────────────────
  // 陣列 = OpenAI 相容端點。未使用的可刪除或留空。
  "providers": {
    "openai": ["sk-..."],
    "orcarouter": ["sk-..."],
    "openrouter": ["sk-or-..."],
    "together": ["..."],
    "mistral": ["..."],
    "cerebras": ["csk-..."],
    "deepseek": ["sk-..."],
    "xai": ["xai-..."],
    "groq": ["gsk_..."],
    "cohere": ["..."],
    "nvidia": ["nvapi-..."],
    "huggingface": ["hf_..."],
    "pollinations": ["sk_..."],
    "literouter": ["..."],
    "llm7": ["..."],
    "gpt4free": ["g4f_..."],
    "opencode": ["sk-..."],
    "anthropic": ["sk-ant-..."],
    "kilo": ["eyJ..."],
    "sea-lion": ["sk-...", "sk-..."],
    "cartesia": ["sk_car_..."],
    "elevenlabs": ["sk_..."],
    "morph": ["sk-..."],
    "aihorde": ["..."],
    "aihubmix": ["..."],
    "navy": ["..."],
    "ollama": ["sk-..."],
    "amd": ["rc-..."],
    "bazaarlink": ["bz-..."],
    "flatkey": ["fk-..."],
    "tokenrouter": ["tr-..."],
    "apinex": ["sk-apx-..."],
    "vyceai": ["sk-..."],

    // 自訂上游。內網 / 私有 IP 會在啟動時被擋下（SSRF 防護）。
    "my-proxy": {
      "apiKeys": ["sk-..."],
      "baseUrl": "https://my-host.example.com",
      "pathPrefix": "/v1",
      "rpm": 20
    }
  },

  // ── 限流 ──────────────────────────────────────────────
  // 每把 key 的請求間隔（毫秒），不是 RPM。
  "rate_limit": {
    "cohere": 1000,
    "nvidia": 1000,
    "gpt4free": 1000,
    "opencode": 1000,
    "sea-lion": 6000
  },

  // 每把 key 每分鐘 token 上限。
  "tpm_limit": {
    "groq": 8000,
    "cerebras": 30000,
    "mistral": 1000000
  },

  // "provider/model" → 單次請求 context 上限（token）。
  "model_limits": {
    "groq/qwen/qwen3.6-27b": 8000,
    "cerebras/zai-glm-4.7": 8000,
    "cohere/command-a-plus-05-2026": 128000,
    "nvidia/mistralai/mistral-medium-3.5-128b": 128000,
    "sea-lion/aisingapore/SEA-LION-ModernBERT-Embedding-600M": 8000
  },

  // ── 端點自動派生 ──────────────────────────────────────
  // model 不在 models 中時，依端點自動回退到對應別名。
  "endpoint_fallbacks": {
    "/v1/chat/completions": "openai",
    "/v1/images/generations": "image",
    "/v1/audio/speech": "tts",
    "/v1/audio/transcriptions": "stt",
    "/v1/embeddings": "embedding",
    "/v1/images/edits": "image",
    "/v1/images/variations": "image",
    "/v1/audio/translations": "stt",
    "/v1/files": "file-store",
    "/v1/messages": "claude"
  },

  // ── Model 別名 ────────────────────────────────────────
  // key = client 送的名稱；value = 依序嘗試的鏈。
  // 單一目標可加 "endpoint"（強制上游端點）或 "fallback"（整鏈失敗後展開的別名）。
  "models": {
    "claude": [
      { "provider": "anthropic", "model": "claude-sonnet-4-20250514" }
    ],
    "opencode-free": [
      { "provider": "opencode", "model": "muse-spark-1.2-contributor-free", "endpoint": "/v1/responses", "fallback": "claude" }
    ],
    "vyceai-auto": [
      { "provider": "vyceai", "model": "auto", "fallback": "openai" }
    ],
    "vyceai-image": [
      { "provider": "vyceai", "model": "grok-imagine-2", "fallback": "image" }
    ],
    "openai": [
      { "provider": "mistral", "model": "mistral-small-latest" },
      { "provider": "cerebras", "model": "zai-glm-4.7" },
      { "provider": "opencode", "model": "deepseek-v4-flash-free" },
      { "provider": "groq", "model": "qwen/qwen3.6-27b" },
      { "provider": "kilo", "model": "kilo-auto/free" },
      { "provider": "cohere", "model": "command-a-plus-05-2026" }
    ],
    "openai-lite": [
      { "provider": "groq", "model": "qwen/qwen3.6-27b", "fallback": "openai" }
    ],
    "openai-max": [
      { "provider": "cohere", "model": "command-a-plus-05-2026" }
    ],

    // 帶圖片時自動切到此鏈。
    "vision": [
      { "provider": "openrouter", "model": "google/gemma-4-31b-it:free" },
      { "provider": "mistral", "model": "mistral-small-latest" }
    ],
    "image": [
      { "provider": "together", "model": "black-forest-labs/FLUX.1-schnell-free" }
    ],
    "tts": [
      { "provider": "cartesia", "model": "sonic-3.5" },
      { "provider": "elevenlabs", "model": "eleven_multilingual_v2" }
    ],
    "stt": [
      { "provider": "cartesia", "model": "ink-whisper" },
      { "provider": "elevenlabs", "model": "scribe_v1" }
    ],
    "embedding": [
      { "provider": "sea-lion", "model": "aisingapore/SEA-LION-ModernBERT-Embedding-600M" }
    ],
    // 值必須是 models 別名，填 provider 名會靜默 fallback 到 openai。
    "file-store": [
      { "provider": "nvidia", "model": "" }
    ]
  },

  // ── 智慧路由 ──────────────────────────────────────────
  // 依估算 token 量 first-fit 由小到大挑 tier。
  "smart_route": {
    "openai": [
      { "alias": "openai-lite", "max_tokens": 4000 },
      { "alias": "openai", "max_tokens": 32000 },
      { "alias": "openai-max", "max_tokens": 128000 }
    ]
  },

  // ── 分類模型 ──────────────────────────────────────────
  // 僅分類不生成；api_key 可留空用免費層。
  "classifier": {
    "base_url": "https://classifier.dev",
    "api_key": "",
    "timeout_ms": 15000,
    "max_chars": 32000,
    "cache": {
      "enabled": true,
      "max_entries": 2000,
      "max_bytes": 8388608,
      "ttl_ms": 3600000
    }
  }
}
