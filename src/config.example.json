{
  "_note": "複製為 config.json。所有值可由同名環境變數覆寫",
  "client_token": "sk-your-secret-token",

  "timezone": "Asia/Taipei",
  "port": 3000,
  "timeout": 600000,
  "key_cooldown": 30000,
  "max_key_backoff": 300000,
  "max_body_size": 10485760,
  "quota_backoff": 3600000,

  "allowed_image_origins": [
    "https://openai.com",
    "https://cdn.openai.com"
  ],

  "model_lockout": {
    "_note": "(選用) 同一 provider/model 連續失敗達 threshold 次後暫時停用 (cooldown_ms 毫秒)",
    "threshold": 3,
    "cooldown_ms": 60000
  },
  "circuit_breaker": {
    "_note": "(選用) circuit breaker: 失敗次數達 threshold 後暫時停用該 provider (cooldown 毫秒)",
    "threshold": 5,
    "cooldown_ms": 30000
  },
  "provider_concurrency": {
    "_note": "(選用) 每個 provider 同時並發請求上限",
    "max_concurrent": 4
  },

  "log": {
    "_note": "(選用) 啟用回應日誌，自動刪除超過 retention_days 的舊資料",
    "enabled": true,
    "retention_days": 7,
    "path": "./log.json"
  },

  "providers": {
    "_note": "只填入有 key 的 provider，未使用的可刪除或留空。支援清單與限制見 README",

    "openai": ["sk-..."],
    "orcarouter": ["sk-..."],
    "openrouter": ["sk-or-..."],
    "together": ["..."],
    "mistral": ["..."],
    "cerebras": ["csk-..."],
    "deepseek": ["sk-..."],
    "xai": ["xai-..."],
    "groq": ["gsk_..."],
    "cohere": ["..."],
    "nvidia": ["nvapi-..."],
    "huggingface": ["hf_..."],
    "pollinations": ["sk_..."],
    "literouter": ["..."],
    "llm7": ["..."],
    "gpt4free": ["g4f_..."],
    "opencode": ["sk-..."],
    "anthropic": ["sk-ant-..."],
    "kilo": ["eyJ..."],
    "sea-lion": ["sk-...", "sk-..."],
    "cartesia": ["sk_car_..."],
    "elevenlabs": ["sk_..."],
    "morph": ["sk-..."],
    "aihorde": ["..."],
    "aihubmix": ["..."],
    "navy": ["..."],
    "ollama": ["sk-..."],
    "amd": ["rc-..."],
    "bazaarlink": ["bz-..."],
    "flatkey": ["fk-..."],
    "tokenrouter": ["tr-..."],
    "apinex": ["sk-apx-..."],
    "vyceai": ["sk-..."],

    "_custom_provider_example": "下方為自定 provider 範例",
    "my-proxy": {
      "apiKeys": ["sk-..."],
      "baseUrl": "https://my-host.example.com",
      "pathPrefix": "/v1",
      "rpm": 20
    }
  },

  "rate_limit": {
    "_note": "每個 key 請求間隔: 毫秒。不在此清單的 provider 會依 key 數量與 PROVIDER_RPM 自動計算",
    "cohere": 1000,
    "nvidia": 1000,
    "gpt4free": 1000,
    "opencode": 1000,
    "sea-lion": 6000
  },

  "tpm_limit": {
    "_note": "每 key 每分鐘 token 限制",
    "groq": 8000,
    "cerebras": 30000,
    "mistral": 1000000
  },

  "model_limits": {
    "_note": "每次請求 token 上限: provider/model → max context",
    "groq/qwen/qwen3.6-27b": 8000,
    "cerebras/zai-glm-4.7": 8000,
    "cohere/command-a-plus-05-2026": 128000,
    "nvidia/mistralai/mistral-medium-3.5-128b": 128000,
    "sea-lion/aisingapore/SEA-LION-ModernBERT-Embedding-600M": 8000
  },

  "endpoint_fallbacks": {
    "_note": "client model 不在 models 中時，依端點路徑自動回退到對應的 model 別名",
    "/v1/chat/completions": "openai",
    "/v1/images/generations": "image",
    "/v1/audio/speech": "tts",
    "/v1/audio/transcriptions": "stt",
    "/v1/embeddings": "embedding",
    "/v1/images/edits": "image",
    "/v1/images/variations": "image",
    "/v1/audio/translations": "stt",
    "/v1/files": "nvidia",
    "/v1/messages": "claude"
  },

  "models": {
    "_note": "key = client 送的 model 名稱；value = provider/model 的 fallback 鏈，依序嘗試",
    "claude": [
      { "provider": "anthropic", "model": "claude-sonnet-4-20250514" }
    ],
    "opencode-free": [
      { "provider": "opencode", "model": "muse-spark-1.2-contributor-free", "endpoint": "/v1/responses", "fallback": "claude" }
    ],
    "vyceai-auto": [
      { "provider": "vyceai", "model": "auto", "fallback": "openai" }
    ],
    "vyceai-image": [
      { "provider": "vyceai", "model": "grok-imagine-2", "fallback": "image" }
    ],
    "openai": [
      { "provider": "mistral", "model": "mistral-small-latest" },
      { "provider": "cerebras", "model": "zai-glm-4.7" },
      { "provider": "opencode", "model": "deepseek-v4-flash-free" },
      { "provider": "groq", "model": "qwen/qwen3.6-27b" },
      { "provider": "kilo", "model": "kilo-auto/free" },
      { "provider": "cohere", "model": "command-a-plus-05-2026" }
    ],
    "openai-lite": [
      { "provider": "groq", "model": "qwen/qwen3.6-27b", "fallback": "openai" }
    ],
    "openai-max": [
      { "provider": "cohere", "model": "command-a-plus-05-2026" }
    ],

    "vision": [
      { "provider": "openrouter", "model": "google/gemma-4-31b-it:free" },
      { "provider": "mistral", "model": "mistral-small-latest" }
    ],
    "image": [
      { "provider": "together", "model": "black-forest-labs/FLUX.1-schnell-free" }
    ],
    "tts": [
      { "provider": "cartesia", "model": "sonic-3.5" },
      { "provider": "elevenlabs", "model": "eleven_multilingual_v2" }
    ],
    "stt": [
      { "provider": "cartesia", "model": "ink-whisper" },
      { "provider": "elevenlabs", "model": "scribe_v1" }
    ],
    "embedding": [
      { "provider": "sea-lion", "model": "aisingapore/SEA-LION-ModernBERT-Embedding-600M" }
    ]
  },

  "smart_route": {
    "_note": "依照 token 量調用適合上游",
    "openai": [
      { "alias": "openai-lite", "max_tokens": 4000 },
      { "alias": "openai", "max_tokens": 32000 },
      { "alias": "openai-max", "max_tokens": 128000 }
    ]
  },

  "classifier": {
    "_note": "classifier.dev 決策模型， api_key 可不填寫，預設使用免費層級調用",
    "base_url": "https://classifier.dev",
    "api_key": "",
    "timeout_ms": 15000,
    "max_chars": 2000,
    "cache": {
      "_note": "內建快取機制",
      "enabled": true,
      "max_entries": 2000,
      "max_bytes": 8388608,
      "ttl_ms": 3600000
    }
  }
}